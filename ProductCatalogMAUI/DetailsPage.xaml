<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductCatalogMAUI.DetailsPage"
             Title="Product Details">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Entry x:Name="nameEntry"
               Placeholder="Name"
               FontSize="24"
               FontAttributes="Bold" />
        <Entry x:Name="categoryEntry"
               Placeholder="Category" />
        <Entry x:Name="priceEntry"
               Placeholder="Price"
               Keyboard="Numeric" />
        <Entry x:Name="quantityEntry"
               Placeholder="Quantity"
               Keyboard="Numeric" />
        <Label x:Name="stockValueLabel"
               Text="{Binding StockValue, StringFormat='Stock Value: {0:C}'}" />
        <Label x:Name="descriptionLabel" />
        <Label x:Name="errorLabel"
               TextColor="Red"
               IsVisible="False" />
        <Label x:Name="successLabel"
               TextColor="Green"
               IsVisible="False" />
        <Button Text="Save" Clicked="Save_Clicked" />
        <Button Text="Return to List" Clicked="ReturnToList_Clicked" />
    </VerticalStackLayout>
</ContentPage>
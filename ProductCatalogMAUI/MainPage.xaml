<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductCatalogMAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Search section -->
            <Border Stroke="#512BD4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Search products by name:"
                           FontAttributes="Bold" />
                    <SearchBar x:Name="ProductSearchBar"
                               Placeholder="Enter product name..."
                               TextChanged="OnSearchBarTextChanged" />
                </VerticalStackLayout>
            </Border>

            <Entry x:Name="ProductNameEntry"
                   Placeholder="Enter product name"
                   Keyboard="Text" />

            <Entry x:Name="ProductPriceEntry"
                   Placeholder="Enter product price"
                   Keyboard="Numeric" />

            <Picker x:Name="ProductCategoryPicker">
                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                </Picker.Items>
            </Picker>
            
            <Entry x:Name="ProductQuantityEntry"
                   Placeholder="Enter product quantity"
                   Keyboard="Numeric" />
            
            <Label x:Name="ErrorMessageLabel"
                   TextColor="Red"
                   IsVisible="False" />
            
            <Button x:Name="AddProductBtn"
                    Text="Add Product"
                    Clicked="OnClickAddProduct"
                    HorizontalOptions="Fill" />

            <Grid ColumnSpacing="10" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Price" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Category" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Quantity" FontAttributes="Bold" />
            </Grid>

            <!-- Number of found products -->
            <Label x:Name="ItemsCounterLabel" 
                   Text="Matching products: 0" />

            <CollectionView x:Name="ProductsCollectionView" 
                            ItemsSource="{Binding VisibleProducts}" 
                            SelectionMode="Single"
                            HeightRequest="300">
                <CollectionView.EmptyView>
                    <Label Text="No products to display." 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*,*,*,*" Padding="0,6">
                            <Label Text="{Binding Name}" Grid.Column="0" />
                            <Label Text="{Binding Price}" Grid.Column="1" />
                            <Label Text="{Binding Category}" Grid.Column="2" />
                            <Label Text="{Binding Quantity}" Grid.Column="3" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="RemoveProductBtn"
                    Text="Remove Product"
                    Clicked="OnClickRemoveProduct"
                    HorizontalOptions="Fill" />

            <Button x:Name="DetailsBtn"
                    Text="Details"
                    Clicked="OnClickDetails"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
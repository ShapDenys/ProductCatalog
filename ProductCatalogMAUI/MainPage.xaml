<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductCatalogMAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Product catalog"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                <Label Text="Add, search and manage your products"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <Border Padding="16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Search products"
                           FontAttributes="Bold"
                           FontSize="16" />
                    <SearchBar x:Name="ProductSearchBar"
                               Placeholder="Enter product name..."
                               TextChanged="OnSearchBarTextChanged"
                               CancelButtonColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add a product"
                           FontAttributes="Bold"
                           FontSize="16" />
                    <Entry x:Name="ProductNameEntry"
                           Placeholder="Product name"
                           Keyboard="Text" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="ProductPriceEntry"
                               Grid.Column="0"
                               Placeholder="Price"
                               Keyboard="Numeric" />
                        <Entry x:Name="ProductQuantityEntry"
                               Grid.Column="1"
                               Placeholder="Quantity"
                               Keyboard="Numeric" />
                    </Grid>
                    <Picker x:Name="ProductCategoryPicker"
                            Title="Category">
                        <Picker.Items>
                            <x:String>A</x:String>
                            <x:String>B</x:String>
                            <x:String>C</x:String>
                        </Picker.Items>
                    </Picker>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="ProductIsAvailableCheckBox"
                                  IsChecked="True"
                                  Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Label Text="Product is available"
                               VerticalOptions="Center"
                               FontSize="14" />
                    </HorizontalStackLayout>
                    <Label x:Name="ErrorMessageLabel"
                           TextColor="#B42318"
                           IsVisible="False"
                           FontSize="13" />
                    <Button x:Name="AddProductBtn"
                            Text="Add product"
                            Clicked="OnClickAddProduct"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="Products"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Label x:Name="ItemsCounterLabel"
                       Grid.Column="1"
                       Text="Matching products: 0"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       VerticalOptions="Center" />
            </Grid>

            <Border Padding="12,8"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="2*,*,*,*"
                          ColumnSpacing="8"
                          Padding="0,4">
                        <Label Grid.Column="0" Text="Name" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="1" Text="Price" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="2" Text="Category" FontAttributes="Bold" FontSize="13" />
                        <Label Grid.Column="3" Text="Quantity" FontAttributes="Bold" FontSize="13" />
                    </Grid>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                    <CollectionView x:Name="ProductsCollectionView"
                                    ItemsSource="{Binding VisibleProducts}"
                                    SelectionMode="Single"
                                    HeightRequest="300">
                        <CollectionView.EmptyView>
                            <Label Text="No products to display."
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,20"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,*,*,*"
                                      ColumnSpacing="8"
                                      Padding="0,8">
                                    <Label Text="{Binding Name}" Grid.Column="0" FontSize="13" />
                                    <Label Text="{Binding Price, StringFormat='{0:C}'}" Grid.Column="1" FontSize="13" />
                                    <Label Text="{Binding Category}" Grid.Column="2" FontSize="13" />
                                    <Label Text="{Binding Quantity}" Grid.Column="3" FontSize="13" />
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid"
                                                     Binding="{Binding IsAvailable}"
                                                     Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="RemoveProductBtn"
                        Text="Remove product"
                        Clicked="OnClickRemoveProduct"
                        HorizontalOptions="Fill"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                        BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                        BorderWidth="1" />
                <Button x:Name="DetailsBtn"
                        Grid.Column="1"
                        Text="Details"
                        Clicked="OnClickDetails"
                        HorizontalOptions="Fill" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductCatalogMAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout
        Padding="30"
        Spacing="20">

            <Label
            x:Name="ProductNameLabel"
            Text="Wyszukiwanie"
            FontSize="32"
            HorizontalTextAlignment="Center" />

            <Entry
            x:Name="ProductNameEntry"
            Placeholder="Enter product name"
            Keyboard="Text" />

            <Button
            x:Name="ChangeColorBtn"
            Text="Change color"
            Clicked="OnClickChangeColor"
            HorizontalOptions="Fill" />

            <Grid ColumnSpacing="10" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Price" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Category" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Quantity" FontAttributes="Bold" />
            </Grid>

            <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*,*,*,*" Padding="0,6">
                            <Label Text="{Binding Name}" Grid.Column="0" />
                            <Label Text="{Binding Price}" Grid.Column="1" />
                            <Label Text="{Binding Category}" Grid.Column="2" />
                            <Label Text="{Binding Quantity}" Grid.Column="3" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
